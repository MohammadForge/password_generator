import random 
import string 

def generate_password(length,num,letter,symbol):
    characters = ''
    

    if letter == 'y':
        characters += string.ascii_letters

    if num == 'y':
        characters += string.digits

    elif symbol == 'y':
        characters += string.punctuation

    password = ''

    
    for _ in range(length):

        password += random.choice(characters)

    return password
    
user_length = int(input('Enter Length: '))
num = input('include numbers(y/n)?: ')
letter = input('Include letters(y/n)?: ')
symbol = input('Include symbols(y/n)?: ')

print(('Generated password: ') , generate_password(user_length,num,letter,symbol))
